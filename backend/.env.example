# Anonymous visitors do not sign in. Only administrators have an account.
DATABASE_URL=postgres://sag:sag@localhost:5432/sag
CONTENT_PORT=3001
AUDIO_PORT=3002
QR_PORT=3003
API_HOST=127.0.0.1
# For native devices: set API_HOST=0.0.0.0 and restrict firewall to the local network.
# CORS_ORIGIN=http://localhost:4173
JWT_SECRET=change-me-in-dev
# DEVICE is free: device speech or an uploaded MP3; no external TTS request.
TTS_PROVIDER=DEVICE
GOOGLE_TTS_KEY=
# AI Studio Gemini TTS (separate from Google Cloud TTS). Keep keys server-side.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE_FEMALE=Kore
GEMINI_VOICE_MALE=Charon
# Optional team assignment: only process these languages, e.g. vi or en,ja.
# Leave empty to process all languages. Restart services after changing this.
TTS_LANGUAGES=
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_DIR=./storage
PUBLIC_ASSET_BASE=/audio-assets
S3_BUCKET=
S3_REGION=
CDN_BASE=

# Optional free self-hosted engine, enabled by npm run dev:local-tts
LOCAL_TTS_URL=http://127.0.0.1:3010
