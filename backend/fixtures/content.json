      "sort_order": 6,
      "translations": [
        {
          "lang_code": "en",
          "name": "Loc Giao Banyan",
          "summary": "Da Loc Giao",
          "script_text": "This is one of the wondrous masterpieces of nature in Cat Tien. The tree has an extraordinarily unique shape, formed by hundreds of clustered roots and trunks intertwining and clinging tightly around a former host tree. The Loc Giao Banyan Tree symbolizes the fierce, resilient, and enduring vitality of tropical forest vegetation.",
          "text_hash": "cd914112e80ee8b373e38111fdae064e9aeaa40d2175201539752558409a319f",
          "audio": {
            "file": "audio/8-en-c8986693246d.mp3",
            "sha256": "c8986693246d36a2f08b15edc1e14b7059a61577a0684f9fcddda194b52f126e",
            "sizeBytes": 395948,
            "durationSec": 24.75,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Charon",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "ロックザオのガジュマル",
          "summary": "Da Loc Giao",
          "script_text": "カッティエンにおける自然の驚異的な傑作の一つです。宿主となった古い木を取り囲み、絡み合いながら密集する何百本もの気根や幹によって、非常に独特な姿をしています。ダ・ロックザオの木は、熱帯雨林の植物が持つ力強く、粘り強く、永続的な生命力を象徴しています。",
          "text_hash": "44ec42fd8f6122706ea7318f710833e3dd63a56312aa8074bdd60d822a6bfba0",
          "audio": {
            "file": "audio/8-ja-650daa074b1d.mp3",
            "sha256": "650daa074b1db5df11ae9621f96c7745b754b91b31cd6f161535a450b4ddc08f",
            "sizeBytes": 402860,
            "durationSec": 25.18,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Aoede",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "록자오 반얀나무",
          "summary": "Da Loc Giao",
          "script_text": "이 나무는 깟띠엔 자연이 빚어낸 경이로운 걸작 중 하나입니다. 수백 가닥의 수염뿌리와 줄기가 기존의 숙주 나무를 칭칭 감고 얽혀 자라면서 매우 독특한 형태를 띠고 있습니다. 록자오 반얀트리는 열대 우림 식생의 강인하고 끈질기며 영원한 생명력을 상징합니다.",
          "text_hash": "34d400b98d8facb7680873427c34c8a00145b3ea39ed1de6d5aa0b2a35b116e6",
          "audio": {
            "file": "audio/8-ko-a9bfe9dbdd4e.mp3",
            "sha256": "a9bfe9dbdd4e8d90eabdf98dd9130965e23b1671ee19eae4fb5c96a9fd97125b",
            "sizeBytes": 384428,
            "durationSec": 24.03,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Iapetus",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Cây Đa Lộc Giao",
          "summary": null,
          "script_text": "Đây là một trong những kiệt tác kỳ lạ của thiên nhiên tại Cát Tiên. Cây có hình dáng vô cùng độc đáo, nhờ hàng trăm bộ rễ chùm và thân cây đan xen, quấn quýt quanh một cây chủ cũ. Cây Đa Lộc Giao tượng trưng cho sức sống mãnh liệt, bền bỉ và trường tồn của thảm thực vật rừng nhiệt đới.",
          "text_hash": "c281d93a850f2d4c2ff6ac3aaf4c205b441f2bb7a5db932d77f207de4eaa22ed",
          "audio": {
            "file": "audio/8-vi-c833f6fd9c7a.mp3",
            "sha256": "c833f6fd9c7ae653688b306afb4aa56afd4508fd731023e880f69c8c8ebcb60a",
            "sizeBytes": 274220,
            "durationSec": 17.14,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Achird",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "鹿交榕树",
          "summary": "Da Loc Giao",
          "script_text": "这是吉仙国家公园神奇的自然杰作之一。这棵树拥有极为奇特的形态，数百条气生根须和树干交织缠绕在一棵原宿主树上。交趾大榕树象征着热带雨林植被顽强、坚韧且生生不息的旺盛生命力。",
          "text_hash": "814113b318dbe4fe79c61f6526d71012fff6e6b4732eed4157df4e787a9374fc",
          "audio": {
            "file": "audio/8-zh-21b03286a3a3.mp3",
            "sha256": "21b03286a3a322f5e78e8ceeb8e198408df5438a082a91f03f9545f666528578",
            "sizeBytes": 345260,
            "durationSec": 21.58,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Sulafat",
            "provider": "GEMINI"
          }
        }
      ]
    },
    {
      "code": "14",
      "map_id": "00000000-0000-0000-0000-000000000001",
      "category_id": 3,
      "latitude": 11.4361,
      "longitude": 107.4525,
      "geo_verified": false,
      "geo_source_url": "urn:sha256:2ede2f7c00e63638604ebdeb843bb7e94aa1e7829fbd982ede01e5b9f5b8a664#point-07",
      "schematic_x": "990.00",
      "schematic_y": "333.00",
      "trigger_radius_m": null,
      "image_url": null,
      "status": "PUBLISHED",
      "sort_order": 7,
      "translations": [
        {
          "lang_code": "en",
          "name": "Troi Waterfall",
          "summary": "Thac Troi",
          "script_text": "Thac Troi, also known as Thac Dung, is a majestic waterfall winding through undulating basalt rock fields in the midst of the vast green forest. The waterfall cascades down with white frothing spray year-round, creating mystical veils of water mist. On beautiful sunny days, sunlight pierces through the mist, creating vibrant rainbows. That is why this place is called Thac Troi, or Heaven Waterfall.",
          "text_hash": "cf9918670b97fc20dc9dc4932a9ed366568e2c23731eccad9cdb8c3f97d7f148",
          "audio": {
            "file": "audio/14-en-176e30b62bea.mp3",
            "sha256": "176e30b62bea4aefaf023c758b8fb5ef6c72be7c751e00ce4ca5fa7765c91b0e",
            "sizeBytes": 459692,
            "durationSec": 28.73,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Charon",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "チョイ滝",
          "summary": "Thac Troi",
          "script_text": "タックズンとも呼ばれるタックチョイは、緑豊かな大自然の中で起伏する玄武岩地帯を縫うように流れる雄大な滝です。滝の水は年中白い水しぶきを上げて流れ落ち、幻想的な水煙を漂わせています。晴れた日には太陽の光が霧を通り抜け、鮮やかな虹の帯を作り出します。そのため、この場所は「天の滝」と名づけられました。",
          "text_hash": "22edb8ac214134cf8d03e18f7ae65bdf120d9128e4d2babe8a57f7a72dc078e3",
          "audio": {
            "file": "audio/14-ja-e19be1d1c02f.mp3",
            "sha256": "e19be1d1c02fb15020406324b45b11933e59fda7404f8b2763798af6ed027e6c",
            "sizeBytes": 451628,
            "durationSec": "28.23",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "쯔어이 폭포",
          "summary": "Thac Troi",
          "script_text": "탁증(Thác Dựng)으로도 불리는 탁쩌이(Thác Trời)는 울창한 원시림 사이로 올록볼록 솟은 현무암 지대를 굽이쳐 흐르는 웅장한 폭포입니다. 일 년 내내 하얀 포말을 뿜어내며 쏟아지는 폭포수는 몽환적인 물안개를 피워 올립니다. 화창한 날이면 햇빛이 물안개를 관통하며 찬란한 무지개를 빚어내어, '하늘의 폭포'라는 뜻의 탁쩌이라는 이름을 얻게 되었습니다.",
          "text_hash": "98a4ad1dc418f6f9973a23409e16968967d10aca24bf8923bcb993e1184d6b92",
          "audio": {
            "file": "audio/14-ko-15558cee1f73.mp3",
            "sha256": "15558cee1f730eccdfd72d5e8dfdc95f93e35c5e479543a4184a4aa82cc83011",
            "sizeBytes": 428972,
            "durationSec": "26.81",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Thác Trời",
          "summary": null,
          "script_text": "Thác Trời, còn gọi là thác Dựng, là một ngọn thác hùng vĩ uốn lượn qua các bãi đá ba-dan nhấp nhô giữa đại ngàn xanh. Nước thác đổ xuống tung bọt trắng xóa quanh năm, tạo nên những màn sương hơi nước mờ ảo. Vào những ngày nắng đẹp, ánh mặt trời xuyên qua làn sương, tạo nên những dải cầu vồng rực rỡ. Vì vậy, nơi đây có tên gọi là Thác Trời.",
          "text_hash": "30570274085b8ca49c8e58a79cc6c157e814c5672fe39f92a9294148a232779d",
          "audio": {
            "file": "audio/14-vi-b0142b3e391a.mp3",
            "sha256": "b0142b3e391a8dc826d458ec060a347d37df5831f17d0ad6f9c26f138fd71eb8",
            "sizeBytes": 405548,
            "durationSec": 25.35,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Achird",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "Troi 瀑布",
          "summary": "Thac Troi",
          "script_text": "天瀑又称立瀑（thác Dựng），是一座雄伟的瀑布，在苍翠森林间起伏的玄武岩石滩中蜿蜒穿行。瀑布终年飞流直下，激起漫天白沫，营造出虚无缥缈的水雾轻纱。在晴好的日子里，阳光穿透薄雾，折射出绚丽多彩的道道彩虹。正因如此，这里才得名“天瀑”。",
          "text_hash": "3e5fb9c0ece6c323a2567a934675d3725b62d53a658a2d045d23bdbc54b24585",
          "audio": {
            "file": "audio/14-zh-2374bee278ba.mp3",
            "sha256": "2374bee278ba9f9ff82733d2ad1c1f70b83082e238c5ca67eba3c8cc9f775e28",
            "sizeBytes": 470060,
            "durationSec": 29.38,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Sulafat",
            "provider": "GEMINI"
          }
        }
      ]
    },
    {
      "code": "5",
      "map_id": "00000000-0000-0000-0000-000000000001",
