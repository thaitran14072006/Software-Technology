      "sort_order": 9,
      "translations": [
        {
          "lang_code": "en",
          "name": "Da Co Crape Myrtle Forest",
          "summary": "Rung bang lang Da Co",
          "script_text": "This is a trail filled with the blossoms of the hairy crape myrtle. During the dry season, particularly from March to May every year, the entire forest sheds its leaves simultaneously and dons a brilliant purple cloak. That romantic and poetic scenery is completely different from the year-round lush green of the primeval forest.",
          "text_hash": "6d3fe5c314e612d6b0f2ab9515485d160dd7a29d356409f1d8c459b1b0703ed1",
          "audio": {
            "file": "audio/15-en-ba7e056b0e91.mp3",
            "sha256": "ba7e056b0e91c6af60183db15cab078868a6a401d0fe63fc4cc5cee1684c6025",
            "sizeBytes": 366380,
            "durationSec": 22.9,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Charon",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "ダコーのサルスベリ林",
          "summary": "Rung bang lang Da Co",
          "script_text": "毛氈状の葉を持つバンランの花の色で溢れるトレイルコースです。乾季、特に毎年三月から五月にかけては、森全体が一斉に葉を落とし、鮮やかな紫色に染まります。このロマンチックで詩的な光景は、一年中青々と茂る原生林の緑とはまったく異なる表情を見せてくれます。",
          "text_hash": "d7e05560253741267515ec14f6f7ae7b58d1c7a918f2d617f3d073db20185031",
          "audio": {
            "file": "audio/15-ja-95b41c5abcf1.mp3",
            "sha256": "95b41c5abcf1a84758cd92f460262e3998b7e80c2653d642be6da0adb66e0eec",
            "sizeBytes": 395948,
            "durationSec": 24.75,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Aoede",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "다꼬 배롱나무 숲",
          "summary": "Rung bang lang Da Co",
          "script_text": "이곳은 털방랑(대왕배롱나무)의 꽃빛으로 물드는 숲길입니다. 건기, 특히 매년 삼월부터 오월 사이가 되면 온 숲이 일제히 낙엽을 떨구고 화려한 보랏빛으로 갈아입습니다. 그 낭만적이고 서정적인 정경은 사시사철 짙푸른 원시림의 풍경과는 완전히 다른 매력을 선사합니다.",
          "text_hash": "3f4e228dfc98b938c32690583487cb409647b0a136e716daca8a1753134353ee",
          "audio": {
            "file": "audio/15-ko-ba39719a1330.mp3",
            "sha256": "ba39719a13301da2b3a942d9744adb6c462f2c0cee54792bea8df46b1ef75f3f",
            "sizeBytes": 440492,
            "durationSec": 27.53,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Iapetus",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Rừng Bằng lăng Đà Cộ",
          "summary": null,
          "script_text": "Đây là tuyến đường mòn ngập tràn sắc hoa của loài bằng lăng ổi lông. Vào mùa khô, đặc biệt từ tháng ba đến tháng năm hằng năm, cả khu rừng đồng loạt trút lá và khoác lên mình màu tím rực rỡ. Khung cảnh lãng mạn, nên thơ ấy khác hoàn toàn với màu xanh mướt quanh năm của rừng già.",
          "text_hash": "5d3aba52c0d2dba4c09645447baa2704af88eff59398ad973ee63a5b75844e86",
          "audio": {
            "file": "audio/15-vi-bf60b8baa11e.mp3",
            "sha256": "bf60b8baa11ee39dfe6ba171be26430752b2dba3b2c46f9c53f22dade6c5a1fa",
            "sizeBytes": 295340,
            "durationSec": 18.46,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Achird",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "Da Co 紫薇林",
          "summary": "Rung bang lang Da Co",
          "script_text": "这是一条开满毛果大花紫薇花朵的林间小径。在旱季，尤其是每年的三月至五月，整片森林几乎同时落叶，并披上绚丽夺目的紫色盛装。这番浪漫诗意的景致，与古老森林一年四季常青的翠绿截然不同。",
          "text_hash": "0f3f6cd43d259fbea3081181e71f5e8f95b89309dc133b3adf8766cba3a9a0bb",
          "audio": {
            "file": "audio/15-zh-250db317c94b.mp3",
            "sha256": "250db317c94b229b78e7fdf269bd0cf8b437dd9fdf4c526cb856695492e67b5b",
            "sizeBytes": 395948,
            "durationSec": "24.75",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        }
      ]
    },
    {
      "code": "1",
