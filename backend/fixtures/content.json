      "translations": [
        {
          "lang_code": "en",
          "name": "Bear Rescue Station",
          "summary": "Khu Cuu ho dong vat hoang da",
          "script_text": "This is the place that receives, provides medical treatment, and gives special care to individual wild animals, especially Asian black bears and sun bears, that have been injured by illegal poaching and trafficking. Here, you will learn humane rescue stories and the work of rehabilitating wild behaviors before releasing the animals back into nature.",
          "text_hash": "af8cc79611d3d5a184cd53465ab5e45bca0866d672ce67af4881b80657192824",
          "audio": {
            "file": "audio/1-en-c821b86029bf.mp3",
            "sha256": "c821b86029bf00a19db03e25a4de60438a7961c0a5e423adcf8de000a6d8a3f5",
            "sizeBytes": 390572,
            "durationSec": "24.41",
            "voiceGender": "FEMALE",
            "voiceName": "Gemini gemini-3.8-flash-tts · Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "クマ救護ステーション",
          "summary": "Khu Cuu ho dong vat hoang da",
          "script_text": "密猟や違法取引の被害に遭い傷ついた野生動物、特にツキノワグマやマレーグマを受け入れ、治療と特別なケアを行う施設です。ここでは、人道的な救護活動の歩みや、動物たちを自然へと戻す前に行われる野生復帰トレーニングの取り組みについて学ぶことができます。",
          "text_hash": "c5864befd4f568eb7b1ef711f97e8c266995f660656e005393bf6fff5b0b89fa",
          "audio": {
            "file": "audio/1-ja-94e1d6829784.mp3",
            "sha256": "94e1d682978426a0032f4c5fecc09d14b80ae8fd9dc848af8f6a0e970f741105",
            "sizeBytes": 395180,
            "durationSec": 24.7,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Aoede",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "곰 구조소",
          "summary": "Khu Cuu ho dong vat hoang da",
          "script_text": "이곳은 불법 밀렵과 거래로 부상을 입거나 피해를 본 야생동물, 특히 아시아흑곰(반달가슴곰)과 말레이곰을 인계받아 의학적 치료와 전문적인 보살핌을 제공하는 공간입니다. 이곳에서는 가슴 뭉클한 동물 구조 이야기와 함께, 치료를 마친 동물들을 다시 대자연으로 돌려보내기 위해 진행하는 야생성 회복 훈련 과정을 자세히 살펴보실 수 있습니다.",
          "text_hash": "987ea326c62e6661bf7b1c2a21a8728d36ea2810567201d9e940b941a524caa0",
          "audio": {
            "file": "audio/1-ko-4c0140ec2ff0.mp3",
            "sha256": "4c0140ec2ff0df3fb61f31f860aedd30ced1ac34dafb4a66b467a2ec4341f576",
            "sizeBytes": 474668,
            "durationSec": 29.67,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Iapetus",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Trạm cứu hộ gấu",
          "summary": null,
          "script_text": "Đây là nơi tiếp nhận, chữa trị y tế và chăm sóc đặc biệt cho các cá thể động vật hoang dã, đặc biệt là gấu ngựa và gấu chó, bị tổn thương do nạn săn bắt và buôn bán trái phép. Tại đây, bạn sẽ được tìm hiểu những câu chuyện cứu hộ đầy nhân văn, và công tác phục hồi tập tính hoang dã trước khi thả các loài về với thiên nhiên.",
          "text_hash": "97ec68a7522f8f2547bc5b504386bf3fca4c171b38713bc4ae6c0df1c466f6a6",
          "audio": {
            "file": "audio/1-vi-152f817ac83c.mp3",
            "sha256": "152f817ac83cc4cde3b182fcd313d592fbe0ba7b76bf81425c9b7e2b8a74d05d",
            "sizeBytes": 319532,
            "durationSec": 19.97,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Achird",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "熊类救护站",
          "summary": "Khu Cuu ho dong vat hoang da",
          "script_text": "这里负责接收、救治并特殊照料因非法盗猎和贩卖而受伤的野生动物个体，特别是亚洲黑熊和马来熊。在这里，您将了解到充满人道关怀的救助故事，并认识帮助动物重获野外生存习性、最终将它们放归自然的相关工作。",
          "text_hash": "8a185289fbf6ddfc235bbe07d4bfa7faf62c413571106d987ce658ae487c30df",
          "audio": {
            "file": "audio/1-zh-e5af4b53cc82.mp3",
            "sha256": "e5af4b53cc827d5e479394816a5bc91dc1c652f68b209daa893160439eddc63f",
            "sizeBytes": 352940,
            "durationSec": 22.06,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Sulafat",
            "provider": "GEMINI"
          }
        }
      ]
    }
  ]
