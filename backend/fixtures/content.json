      "trigger_radius_m": null,
      "image_url": null,
      "status": "PUBLISHED",
      "sort_order": 2,
      "translations": [
        {
          "lang_code": "en",
          "name": "Crocodile Lake",
          "summary": "Bau Sau",
          "script_text": "Bau Sau is a wetland of international importance, recognized under the Ramsar Convention. This place is considered the heart of the Nam Cat Tien ecosystem. This vast wetland is the natural home of hundreds of Siamese crocodiles, a rare freshwater crocodile species once believed to be extinct. Visiting here, you will admire pristine scenery reminiscent of an ink wash painting, and experience rowing a boat amidst the wetland where crocodiles live in their natural habitat.",
          "text_hash": "66c55e508cd56594d7670c33c1ba6779d1dbea8d4f5e94f3ba6e7dd27a64cf15",
          "audio": {
            "file": "audio/9-en-2bef86f1c1e7.mp3",
            "sha256": "2bef86f1c1e73c5489402f424d45192dbf59ff6234ff654c309590c7b709fcbb",
            "sizeBytes": 523820,
            "durationSec": 32.74,
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-tts/Charon",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "クロコダイル湖",
          "summary": "Bau Sau",
          "script_text": "バウサウはラムサール条約に基づき認定された、国際的に重要な湿地帯です。ここはナムカッティエン生態系の心臓部と見なされています。この広大な湿地は、かつて絶滅したと考えられていた希少な淡水性のワニであるシャムワニ数百頭の自然の生息地となっています。ここを訪れると、まるで水墨画のように手つかずの自然の風景を眺めることができ、ワニが自然のまま暮らす湿地の真ん中でボートを漕ぐ体験ができます。",
          "text_hash": "239bde85d4302f2d5a9e68020838f07cd52fb26fa702e2f5201609928a4f4eab",
          "audio": {
            "file": "audio/9-ja-45c145c10daf.mp3",
            "sha256": "45c145c10daf82f4ac0d013cc12a2c6d94f0af02d59a4a758f71b849afe3e197",
            "sizeBytes": 610988,
            "durationSec": "38.19",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "악어 호수",
          "summary": "Bau Sau",
          "script_text": "바우서우는 람사르 협약에 따라 국제적 중요성을 인정받은 습지입니다. 이곳은 남깟띠엔 생태계의 심장부로 꼽힙니다. 이 광활한 늪지는 한때 멸종된 것으로 여겨졌던 희귀 민물 악어 종인 샴악어 수백 마리가 살아가는 자연의 보금자리입니다. 이곳에 오시면 수묵화처럼 원시적인 풍경을 감상할 수 있으며, 악어가 자연 그대로 서식하는 습지 한가운데에서 나룻배를 타는 특별한 체험을 즐기실 수 있습니다.",
          "text_hash": "26e70e645a51326511a23ae2bd0f8a75f1a4f7cc53f142e2886d0b3a709d8020",
          "audio": {
            "file": "audio/9-ko-a5b612d833a5.mp3",
            "sha256": "a5b612d833a502d486b06c7be743a10a5793e51a9365da352799fb269cd9eb68",
            "sizeBytes": 539948,
            "durationSec": "33.75",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Bàu Sấu",
          "summary": null,
          "script_text": "Bàu Sấu là vùng đất ngập nước có tầm quan trọng quốc tế, được công nhận theo công ước Ram-xa. Nơi đây được xem là trái tim của hệ sinh thái Nam Cát Tiên. Đầm lầy rộng lớn này là ngôi nhà tự nhiên của hàng trăm cá thể cá sấu Xiêm, một loài cá sấu nước ngọt quý hiếm, từng được cho là đã tuyệt chủng. Đến đây, bạn sẽ ngắm nhìn cảnh sắc hoang sơ như tranh thủy mặc, và trải nghiệm chèo thuyền giữa đầm nước, nơi cá sấu sinh sống tự nhiên.",
          "text_hash": "81f5755e0aaa1b50ac0423d3769e6fda14a6baef260a1c2785b3064ebca9d383",
          "audio": {
            "file": "audio/9-vi-04db39243e81.mp3",
            "sha256": "04db39243e8142a3c00b61aaca848e4f9bc66b9da6d12d093be590bd7b00474e",
            "sizeBytes": 459692,
            "durationSec": "28.68",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "鳄鱼湖",
          "summary": "Bau Sau",
          "script_text": "鳄鱼湖是具有国际重要意义的湿地，已被列入《拉姆萨尔公约》国际重要湿地名录。这里被视为南吉仙生态系统的核心心脏。这片广袤的沼泽湿地是数百只暹罗鳄的自然家园，暹罗鳄是一种珍稀淡水鳄，曾一度被认为已经灭绝。来到这里，您将欣赏到宛如水墨画般的原始风光，并体验在鳄鱼自然栖息的湖水中荡舟。",
          "text_hash": "88226e9d8fdc94b978283128563b49f7560ce779515362531b5ac68de01f8848",
          "audio": {
            "file": "audio/9-zh-29f8224e0a0f.mp3",
            "sha256": "29f8224e0a0ff8e43b50cd94d6a45fa390d6183eebfcd0e2d6970f6548dc7115",
            "sizeBytes": 533420,
            "durationSec": "33.34",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        }
      ]
    },
    {
