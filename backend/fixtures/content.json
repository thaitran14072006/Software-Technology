      "longitude": 107.4355,
      "geo_verified": false,
      "geo_source_url": "urn:sha256:2ede2f7c00e63638604ebdeb843bb7e94aa1e7829fbd982ede01e5b9f5b8a664#point-09",
      "schematic_x": "532.00",
