      "trigger_radius_m": null,
      "image_url": null,
      "status": "PUBLISHED",
      "sort_order": 8,
      "translations": [
        {
          "lang_code": "en",
          "name": "Ben Cu Rapids",
          "summary": "Ghenh Ben Cu",
          "script_text": "Ben Cu Rapids is located not far from the park headquarters. Here, a section of the Dong Nai River narrows, its torrent rushing and weaving through large, undulating rocky rapids. Ben Cu possesses a wild and rustic beauty, serving as an ideal stopover for you to rest and listen to the murmuring sound of flowing water harmonizing with the songs of forest birds.",
          "text_hash": "a51778f3abfa1be0613a43c71ee5d79342702f27347158073c9539cba6c11981",
          "audio": {
            "file": "audio/5-en-c0cb5d3dccd3.mp3",
            "sha256": "c0cb5d3dccd3d471c32d3ab97cd05952bd10c5a3980c7aefaea3d3fec20bbc11",
            "sizeBytes": 436268,
            "durationSec": "27.27",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ja",
          "name": "ベンクーの急流",
          "summary": "Ghenh Ben Cu",
          "script_text": "ベンクーの浅瀬は、国立公園管理本部からそう遠くない場所に位置しています。ここはドンナイ川の川幅が狭まり、起伏のある大きな岩礁地帯を縫って急流が激しく流れる場所です。素朴で手つかずの美しさを持ち、腰を下ろして休憩しながら、森の鳥の声と溶け合うせせらぎの音に耳を傾けるのに理想的な立ち寄りスポットです。",
          "text_hash": "a5988415847ec7d97ec3f3b39a21da1a9a1e2713810240290c30e13e4a76e91b",
          "audio": {
            "file": "audio/5-ja-374dd5315d7f.mp3",
            "sha256": "374dd5315d7fad591665207c264f5ba3da63b5d9f497f5646a1d458f88adae15",
            "sizeBytes": 411308,
            "durationSec": "25.71",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "ko",
          "name": "벤꾸 급류",
          "summary": "Ghenh Ben Cu",
          "script_text": "벤끄 급류는 공원 관리사무소에서 그리 멀지 않은 곳에 있습니다. 이곳은 동나이강의 강폭이 좁아지며 물살이 거세져 올록볼록 솟은 거대한 암초들 사이를 파고들며 흐르는 구간입니다. 원시적이고 소박한 멋을 지닌 벤끄는 잠시 멈추어 서서 숲속 새소리와 어우러지는 청량한 물소리를 들으며 휴식을 취하기에 안성맞춤인 곳입니다.",
          "text_hash": "15e9260cf9c0090ed6fa1c12ca498b121d59cd991dc646201783f11a86052b93",
          "audio": {
            "file": "audio/5-ko-ff3935238924.mp3",
            "sha256": "ff39352389246a31305dc05d5c8eeb5dc8e3efa0f3ccbad693667ac009999ddf",
            "sizeBytes": 455852,
            "durationSec": "28.49",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "vi",
          "name": "Ghềnh Bến Cự",
          "summary": null,
          "script_text": "Ghềnh thác Bến Cự tọa lạc cách trụ sở vườn không xa. Đây là đoạn sông Đồng Nai co hẹp lại, dòng nước chảy xiết, luồn lách qua những bãi ghềnh đá lớn nhấp nhô. Bến Cự mang vẻ đẹp hoang sơ, mộc mạc, là điểm dừng chân lý tưởng để bạn ngồi nghỉ, lắng nghe tiếng nước chảy rì rào hòa quyện cùng tiếng chim rừng.",
          "text_hash": "78080688529a3d0bebf036a0bcdf8f99feabd398def97f0384b705d67d780498",
          "audio": {
            "file": "audio/5-vi-aa44eb2c1ee1.mp3",
            "sha256": "aa44eb2c1ee12656e93495aa2f1d44ecb9c819b150d8ef90dd635cd29b99b7fc",
            "sizeBytes": 346028,
            "durationSec": "21.63",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        },
        {
          "lang_code": "zh",
          "name": "Ben Cu 急流",
          "summary": "Ghenh Ben Cu",
          "script_text": "巨滩险滩距离公园管理总部不远。这里是同奈河收窄的河段，水流湍急，穿行在起伏交错的巨石滩之间。巨滩散发着原始质朴之美，是您歇脚小憩的理想去处，您可以坐在这里聆听潺潺流水声与林中鸟鸣交织共鸣。",
          "text_hash": "c89a0ef0c595e119742582a764b98579a210570cece2a3db3a8e7950be2dc46a",
          "audio": {
            "file": "audio/5-zh-a8fd20a6c58d.mp3",
            "sha256": "a8fd20a6c58d3299bf26622e05a5acd16a3ded81637a81e52a6aa910449631ff",
            "sizeBytes": 386732,
            "durationSec": "24.17",
            "voiceGender": "FEMALE",
            "voiceName": "gemini-3.8-flash-lite-tts/Kore",
            "provider": "GEMINI"
          }
        }
      ]
    },
    {
      "code": "15",
      "map_id": "00000000-0000-0000-0000-000000000001",
      "category_id": 2,
      "latitude": 11.4552,
      "longitude": 107.4045,
      "geo_verified": false,
      "geo_source_url": "urn:sha256:2ede2f7c00e63638604ebdeb843bb7e94aa1e7829fbd982ede01e5b9f5b8a664#point-10",
