    {
      "code": "9",
      "map_id": "00000000-0000-0000-0000-000000000001",
      "category_id": 3,
      "latitude": 11.4594,
      "longitude": 107.3486,
      "geo_verified": false,
      "geo_source_url": "urn:sha256:2ede2f7c00e63638604ebdeb843bb7e94aa1e7829fbd982ede01e5b9f5b8a664#point-02",
      "schematic_x": "212.00",
