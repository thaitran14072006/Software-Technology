{
  "name": "smart-audio-guide-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build content-poi-service && nest build audio-tts-service && nest build qr-fallback-service",
    "start:content": "nest start content-poi-service --watch",
    "start:audio": "nest start audio-tts-service --watch",
    "start:qr": "nest start qr-fallback-service --watch",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/microservices": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/typeorm": "^12.0.2",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/messaging/(.*)$": "<rootDir>/libs/messaging/src/$1",
      "^@app/database/(.*)$": "<rootDir>/libs/database/src/$1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
