{
  "name": "smart-audio-guide-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-track-player.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "test": "jest",
    "test:i18n": "node scripts/check-plural-rules.mjs",
    "i18n:export": "node ../scripts/export-i18n.js",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@formatjs/intl-pluralrules": "6.3.16",
    "@maplibre/maplibre-react-native": "10.4.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "babel-preset-expo": "~54.0.10",
    "buffer": "^6.0.3",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-file-system": "~19.0.0",
    "expo-location": "~19.0.0",
    "expo-speech": "~14.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.0",
    "i18next": "^23.16.0",
    "react": "19.1.0",
    "react-i18next": "^15.0.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.2.0",
    "react-native-mmkv": "^3.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-track-player": "^4.1.1",
    "react-native-vision-camera": "^4.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": {
            "module": "commonjs",
            "target": "es2020",
            "esModuleInterop": true,
            "resolveJsonModule": true,
            "skipLibCheck": true
          }
        }
      ]
    }
  }
}
